ENVIRONMENT=development
AUTO_CREATE_DB=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=sqlite+aiosqlite:///./app.db
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidence-files
STORAGE_TIMEOUT_SECONDS=20
RAG_BACKEND=memory

GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
OPENSANCTIONS_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

LLM_TIMEOUT_SECONDS=45
WEB_TIMEOUT_SECONDS=20
FREE_SOURCE_TIMEOUT_SECONDS=10
MAX_CHAT_MESSAGES=40
MAX_CHAT_CHARS=60000
MAX_EVIDENCE_TEXT_CHARS=50000
MAX_UPLOAD_BYTES=15728640

WHED_URL=https://whed.net/results_institutions.php
SECP_SEARCH_URL=https://eservices.secp.gov.pk/eServices/NameSearch.jsp
