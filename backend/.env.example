# VerifyAbroad-AI backend — copy to .env for local development.
# On Render these live in the service's Environment tab (never commit real keys).

ENVIRONMENT=development
# Creates any missing table at startup. Safe to leave true (create_all is
# idempotent); set false if you run `alembic upgrade head` yourself.
AUTO_CREATE_DB=true
LOG_LEVEL=INFO

# The browser never calls this API directly — the Next.js server does, from the
# server side, where CORS does not apply. Set this only if you expose routes to
# the client: the exact https origin of your Vercel deployment, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database -----------------------------------------------------------------
# Local default (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Supabase / Neon / Render Postgres — plain postgres:// or postgresql:// works,
# the app rewrites it to the async driver for you:
#   DATABASE_URL=postgresql://user:pass@aws-0pooler.supabase.co:6543/postgres?sslmode=require
#   DB_SSLMODE=require
DB_SSLMODE=
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidence-files
STORAGE_TIMEOUT_SECONDS=20
RAG_BACKEND=memory

# --- Provider keys ------------------------------------------------------------
# All optional: with no key the investigator, evidence parser and report
# narrative use the deterministic fallbacks, so the app still works end to end.
# ROTATE any key that has ever been shared in a chat or committed to git.
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
OPENSANCTIONS_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GROQ_MODEL=qwen/qwen3.6-27b
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

LLM_TIMEOUT_SECONDS=45
WEB_TIMEOUT_SECONDS=20
FREE_SOURCE_TIMEOUT_SECONDS=10
MAX_CHAT_MESSAGES=40
MAX_CHAT_CHARS=60000
MAX_EVIDENCE_TEXT_CHARS=50000
MAX_UPLOAD_BYTES=15728640

# true = degrade gracefully instead of returning 502 when a provider fails.
OFFLINE_FALLBACKS=true
# Ingest data/fraud_patterns_seed.json into the RAG table on boot (needs a
# Gemini embedding key; skipped silently otherwise).
INGEST_SEED_ON_STARTUP=true

WHED_URL=https://whed.net/results_institutions.php
SECP_SEARCH_URL=https://eservices.secp.gov.pk/eServices/NameSearch.jsp
APP_SECRET=change-me
