# ─────────────────────────────────────────────────────────────────────────────
# VerifyAbroad AI — frontend environment
# ─────────────────────────────────────────────────────────────────────────────
# Everything here is SERVER-SIDE (read inside Next.js route handlers and server
# components). Nothing is sent to the browser: no provider key, no database URL
# and no backend service token ever reaches the client bundle.
# The browser only ever calls this app's own /api routes.

# ── Primary data source: the FastAPI backend (deployed on Render) ────────────
# Set this and the whole app — chat, evidence, verification, history, accounts,
# profile — is served by the Python backend, which owns its own Postgres.
# The frontend then needs NO database of its own.
#   local:  BACKEND_URL=http://localhost:8000
#   deploy: BACKEND_URL=https://verifyabroad-api.onrender.com
BACKEND_URL=

# What to do when BACKEND_URL is set but unreachable (a free Render instance
# sleeps after 15 idle minutes, so the first call can fail).
#   internal → downgrade to the built-in deterministic engine (needs DATABASE_URL)
#   off      → fail with a clear "waking up, try again in ~30s" message
BACKEND_FALLBACK=off

# ── Internal engine only (leave blank if you set BACKEND_URL) ────────────────
# Postgres for the built-in engine in src/server. Without it, directory pages
# (universities / scholarships / consultants) still work from the bundled
# reference data, but investigations, history and accounts need the backend.
DATABASE_URL=

# Optional LLM keys for the internal engine's narrative layer. The backend keeps
# its own GEMINI_API_KEY / GROQ_API_KEY / TAVILY_API_KEY — set those on Render.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# ── Session cookie ───────────────────────────────────────────────────────────
# Fixed names, set by this server only (httpOnly, SameSite=Lax, 30–60 days):
#   va_student_key  anonymous browser session  (src/proxy.ts)
#   va_auth         signed-in account key       (/api/auth/login, /api/auth/signup)
# getStudentKey() prefers the account key and forwards it as X-Student-Key, so no
# CORS or cross-site cookie setting is needed on either host.

# ── Do NOT set ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL — pointing the browser straight at Render would break
# the session cookie and force a CORS allowlist for no benefit. /api only.
